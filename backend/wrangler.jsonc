{
  "name": "voiceofvrindavan-live-preview",
  "main": "live-worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOMS",
        "class_name": "ChatRoom"
      },
      {
        "name": "CHAT_LOBBIES",
        "class_name": "ChatLobby"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatRoom",
        "ChatLobby"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "COMMUNITY_DB",
      "database_name": "voiceofvrindavan-community-preview",
      "database_id": "42b43ef2-20e7-4852-8ffc-7bebcf1683fb"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "env": {
    "production": {
      "name": "voiceofvrindavan-live",
      "d1_databases": [
        {
          "binding": "COMMUNITY_DB",
          "database_name": "voiceofvrindavan-community",
          "database_id": "849a5f8d-43b7-400c-b2c0-c6c5e8d3487e"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CHAT_ROOMS",
            "class_name": "ChatRoom"
          },
          {
            "name": "CHAT_LOBBIES",
            "class_name": "ChatLobby"
          }
        ]
      }
    }
  }
}
